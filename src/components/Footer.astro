---
import Logo from './Logo.astro';
import { NAV, SITE } from '../config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div style="display:flex; align-items:center; gap:0.5rem;">
      <Logo />
      <span>{SITE.title} — {SITE.tagline}</span>
    </div>

    <nav aria-label="Footer navigation">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>

    <div>
      &copy; {year} {SITE.title} · Built with
      <a href="https://astro.build" rel="noopener noreferrer" target="_blank">Astro</a>
    </div>

    <p class="foot-disclaimer">
      Personal project built on my own time from public data and published literature.
      Views are my own and do not represent any employer or organization.
    </p>
  </div>
</footer>

<style>
  .foot-disclaimer {
    width: 100%;
    font-size: 0.78rem;
    color: var(--text-faint);
    border-top: 1px solid var(--border);
    padding-top: 0.9rem;
  }
</style>
