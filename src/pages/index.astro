---
import Layout from '../layouts/Base.astro';
import { SITE } from '../config';
import { formatDate } from '../utils';
import { getCollection } from 'astro:content';

const research = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.weight ?? 0) - (a.data.weight ?? 0) || b.data.pubDate - a.data.pubDate);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate - a.data.pubDate)
  .slice(0, 3);

const featured = research.slice(0, 2);
const stats = [
  { value: '15+ yrs', label: 'Nuclear energy & operations' },
  { value: '2', label: 'Flagship mission-model applications' },
  { value: '135+', label: 'Automated tests in the HLW model suite' },
  { value: '1–2 s', label: 'Full campaign simulation runtime' },
];
---

<Layout>
  <section class="hero">
    <div class="container hero-inner">
      <span class="badge">Personal Research Laboratory</span>
      <h1>Linking <span class="gradient-text">AI & machine learning</span> with the nuclear backend.</h1>
      <p class="lede">
        {SITE.title} is the research workspace of Aspen — a process engineer working the
        Hanford high-level waste mission by day, and building the data, modeling, and
        machine-learning tooling that mission needs by night. Waste disposal, treatment,
        and power, enhanced by modern computation.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/research/">Explore research</a>
        <a class="btn btn-ghost" href="/cv/">View CV</a>
      </div>

      <dl class="stat-strip glass-card">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Featured research</p>
      <h2 class="section-title">Flagship projects</h2>
      <div class="card-grid cols-2">
        {
          featured.map((project) => (
            <a class="glass-card project-card" href={`/research/${project.id}/`}>
              <div class="meta-row">
                <span class="badge">{project.data.status}</span>
                <span>{project.data.tags.slice(0, 3).join(' · ')}</span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <span class="card-cta">Read the write-up →</span>
            </a>
          ))
        }
      </div>
      <p class="section-more">
        <a href="/research/">All research projects →</a>
      </p>
    </div>
  </section>

  <section class="section section-sm">
    <div class="container">
      <p class="eyebrow">From the blog</p>
      <h2 class="section-title">Recent writing</h2>
      <div class="card-grid cols-3">
        {
          posts.map((post) => (
            <a class="glass-card project-card" href={`/blog/${post.id}/`}>
              <div class="meta-row">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="card-cta">Read post →</span>
            </a>
          ))
        }
      </div>
      <p class="section-more">
        <a href="/blog/">All posts →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: 5.5rem 3.5rem;
  }

  .hero-inner {
    max-width: 56rem;
  }

  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 6vw, 3.6rem);
  }

  .hero .lede {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 44rem;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stat-strip {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
  }

  .stat dd {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat dt {
    order: 2;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  @media (min-width: 48rem) {
    .stat-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .section-title {
    margin-top: 0.4rem;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--text);
  }

  .project-card:hover {
    text-decoration: none;
  }

  .project-card h3 {
    font-size: 1.2rem;
  }

  .project-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .card-cta {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent-strong);
  }

  .section-more {
    margin-top: 1.5rem;
  }
</style>
