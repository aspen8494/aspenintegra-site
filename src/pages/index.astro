---
import Layout from '../layouts/Base.astro';
import { SITE } from '../config';
import { formatDate } from '../utils';
import { getCollection } from 'astro:content';

const research = (await getCollection('research', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.weight ?? 0) - (a.data.weight ?? 0) || b.data.pubDate - a.data.pubDate);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate - a.data.pubDate)
  .slice(0, 3);

const featured = research.slice(0, 2);
const stats = [
  { value: '10 yrs', label: 'Nuclear energy & operations' },
  { value: '2', label: 'Flagship mission-model applications' },
  { value: '135+', label: 'Automated tests in the HLW model suite' },
  { value: '1–2 s', label: 'Full campaign simulation runtime' },
];

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Aspen Integra',
  alternateName: 'Aspen Integra Personal Research Laboratory',
  url: 'https://aspenintegra.com/',
  description:
    'Open-source nuclear waste research: Hanford tank waste databases, Best-Basis Inventory data, machine-learning mission models, interactive public dashboards, and free white papers on vitrification and tank-farm mission planning.',
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    name: 'Aspen',
    url: 'https://aspenintegra.com/',
  },
};
---

<Layout
  jsonLd={websiteLd}
  title="Hanford Tank Waste & Open Nuclear Data — Research Lab"
  description="Open-source Hanford tank waste research: the 177-tank Best-Basis Inventory, SRS tank waste database, ML mission models, white papers, and public dashboards."
>
  <section class="hero">
    <div class="container hero-inner">
      <span class="badge">Personal Research Laboratory</span>
      <h1>Linking <span class="gradient-text">AI & machine learning</span> with the nuclear backend.</h1>
      <p class="lede">
        {SITE.title} is the research workspace of Aspen, a nuclear process engineer
        with a decade across operations, training, safety basis, commissioning, and
        plant engineering. I build the modeling and machine-learning tools the nuclear
        backend has been missing, aimed at waste disposal, treatment, and power.
        Everything is built open source, from public data, so the public can actually
        explore it.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/research/">Explore research</a>
        <a class="btn btn-ghost" href="/contact/">Get in touch</a>
      </div>

      <dl class="stat-strip glass-card">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Featured research</p>
      <h2 class="section-title">Flagship projects</h2>
      <div class="card-grid cols-2">
        {
          featured.map((project) => (
            <a class="glass-card project-card" href={`/research/${project.id}/`}>
              <div class="meta-row">
                <span class="badge">{project.data.status}</span>
                <span>{project.data.tags.slice(0, 3).join(' · ')}</span>
              </div>
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <span class="card-cta">Read the write-up →</span>
            </a>
          ))
        }
      </div>
      <div class="glass-card paper-cta">
        <div>
          <span class="eyebrow">New</span>
          <h3>White papers & interactive dashboard</h3>
          <p>
            Campaign retrieval optimization (LNS) and coupled mission planning papers,
            embedded for reading, plus the Streamlit dashboard for live process flow,
            trends, and stream ledgers.
          </p>
        </div>
        <a class="btn btn-primary" href="/papers/">Read the papers →</a>
      </div>
      <p class="section-more">
        <a href="/research/">All research projects →</a>
      </p>
    </div>
  </section>

  <section class="section section-sm">
    <div class="container">
      <p class="eyebrow">Open nuclear data</p>
      <h2 class="section-title">Hanford & SRS tank waste, open source</h2>
      <div class="card-grid cols-2">
        <a class="glass-card project-card" href="/data/">
          <div class="meta-row">
            <span class="badge">Database</span>
            <span>SQLite · CSV · JSON</span>
          </div>
          <h3>Tank waste databases, free to download</h3>
          <p>
            The SRS tank waste database — 51 tanks of Best-Basis-Inventory-style
            inventory data assembled from public documents — and the full
            Hanford 177-tank Best-Basis Inventory comparison set. Every row
            carries its dataset, basis, and source.
          </p>
          <span class="card-cta">Download the data →</span>
        </a>
        <a class="glass-card project-card" href="/playground/">
          <div class="meta-row">
            <span class="badge">Interactive</span>
            <span>Runs in your browser</span>
          </div>
          <h3>Explore the waste yourself</h3>
          <p>
            Four live dashboards built on the open data: the SRS vs Hanford
            tank comparison, an unsupervised cross-site waste taxonomy, a
            glass property explorer, and the HLW blend sandbox. No server,
            no sign-up — every experiment runs client-side.
          </p>
          <span class="card-cta">Open the playground →</span>
        </a>
        <a class="glass-card project-card" href="/glass-research-db/">
          <div class="meta-row">
            <span class="badge">Bibliography</span>
            <span>17.9k records · 1976–present</span>
          </div>
          <h3>Hanford glass research, searchable</h3>
          <p>
            Every published study on Hanford waste-glass composition and
            formulation algorithms — from the pioneering 1970s vitrification
            work to today's property models. Search 6,700+ curated records in
            the browser, or download all 17.9k.
          </p>
          <span class="card-cta">Search the database →</span>
        </a>
      </div>
      <p class="section-more">
        <a href="/papers/">Read the white papers →</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">From the blog</p>
      <h2 class="section-title">Recent writing</h2>
      <div class="card-grid cols-3">
        {
          posts.map((post) => (
            <a class="glass-card project-card" href={`/blog/${post.id}/`}>
              <div class="meta-row">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="card-cta">Read post →</span>
            </a>
          ))
        }
      </div>
      <p class="section-more">
        <a href="/blog/">All posts →</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: 5.5rem 3.5rem;
  }

  .hero-inner {
    max-width: 56rem;
  }

  .hero h1 {
    margin-top: 1.1rem;
    font-size: clamp(2.3rem, 6vw, 3.6rem);
  }

  .hero .lede {
    margin-top: 1.25rem;
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 44rem;
  }

  .hero-actions {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .stat-strip {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    padding: 1.5rem 1.75rem;
  }

  .stat dd {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .stat dt {
    order: 2;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  @media (min-width: 48rem) {
    .stat-strip {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .section-title {
    margin-top: 0.4rem;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    color: var(--text);
  }

  .project-card:hover {
    text-decoration: none;
  }

  .project-card h3 {
    font-size: 1.2rem;
  }

  .project-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex-grow: 1;
  }

  .card-cta {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent-strong);
  }

  .section-more {
    margin-top: 1.5rem;
  }

  .paper-cta {
    margin-top: 1.25rem;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .paper-cta:hover {
    transform: none;
  }

  .paper-cta h3 {
    font-size: 1.15rem;
    margin-top: 0.25rem;
  }

  .paper-cta p {
    color: var(--text-muted);
    font-size: 0.93rem;
    margin-top: 0.3rem;
    max-width: 36rem;
  }
</style>
