---
import Layout from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { SITE } from '../config';

const skillGroups = [
  {
    domain: 'Process & nuclear engineering',
    skills: [
      'Vitrification & off-gas treatment systems',
      'Joule-heated melter operations & troubleshooting',
      'Commissioning & startup test engineering',
      'DOE-STD-3009 / DOE-STD-1228-2019 safety basis',
      'DSAs, TSRs, and hazard analyses',
    ],
  },
  {
    domain: 'Modeling & data',
    skills: [
      'Process stream-flow & thermodynamic modeling (Python)',
      'Campaign/mission planning algorithms (LP/QP)',
      'Monte-Carlo sensitivity sweeps & verification suites',
      'Tank inventory data pipelines & API ingestion',
      'Streamlit engineering dashboards',
    ],
  },
  {
    domain: 'Machine learning & automation',
    skills: [
      'LLM-assisted engineering workflows & agent orchestration',
      'Local LLM inference (Ollama) & document pipelines',
      'Classification systems & evaluation harness design',
      'Git-driven development & CI (GitHub Actions)',
    ],
  },
];

const openSource = [
  {
    href: 'https://github.com/aspen8494/hanford-blend-sandbox',
    title: 'HLW Blend Sandbox',
    detail:
      'In-browser mission planning toy: the campaign-packing problem, its glass formulation, and mission rollups, running entirely client-side.',
  },
  {
    href: 'https://github.com/aspen8494/glass-property-explorer',
    title: 'Glass Property Explorer',
    detail:
      'Drag composition sliders and watch melt viscosity, conductivity, and PCT release respond, computed by both a neural network and the published property models.',
  },
  {
    href: 'https://github.com/aspen8494/srs-tank-waste-database',
    title: 'SRS Tank Waste Database',
    detail:
      'The first public SRS-vs-Hanford inventory comparison: 51 Savannah River tanks against the 177-tank Hanford BBI, every row carrying its dataset, basis, and source.',
  },
  {
    href: 'https://github.com/aspen8494/hlw-facility-mission-model',
    title: 'HLW Facility Mission Model',
    detail:
      'Element-conserving, speciated simulation of a vitrification plant and its complete off-gas train, plus the campaign builder that sequences the whole mission.',
  },
];

const projects = [
  {
    href: '/research/hlw-facility-mission-model/',
    title: 'Facility mission model',
    detail:
      'Element-conserving, speciated simulation of a high-level waste vitrification plant and its full off-gas train, driven by real campaign schedules.',
  },
  {
    href: '/research/ewg-campaign-builder/',
    title: 'Campaign builder',
    detail:
      'Mission planning application: published tank inventory to sequenced retrieval campaigns with WAC evaluation and glass-forming optimization.',
  },
  {
    href: '/playground/',
    title: 'Playground experiments',
    detail:
      'Small in-browser models of the same ideas: capture trains, glass properties, mission packing.',
  },
];

const timeline = [
  {
    period: '2026 —',
    title: 'Independent research — Aspen Integra',
    detail:
      'Founded a personal research laboratory linking AI/ML with nuclear waste disposal, treatment, and power. Built the campaign builder and the facility mission model.',
  },
  {
    period: '2020 — 2022',
    title: 'Commissioning Test Engineer — U.S. nuclear waste treatment project',
    detail:
      'Planned, prepared, and executed test documents validating facility design; supervised commissioning technicians.',
  },
  {
    period: '2019 — 2020',
    title: 'Nuclear Safety Engineer — U.S. nuclear waste treatment project',
    detail:
      'Maintained the facility DSA, TSRs, and hazard analyses; transitioned the safety basis to DOE-STD-1228-2019.',
  },
  {
    period: '2017 — 2019',
    title: 'Reactor Operations Training Engineer — U.S. naval nuclear program',
    detail:
      'Instructed naval nuclear operators on S5W/S6G reactor plants; advanced plant simulation; qualified EOOW (2018).',
  },
];
---

<Layout
  title="About"
  description="About Aspen, the process engineer and researcher behind Aspen Integra, working at the intersection of nuclear waste treatment and applied AI."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About</p>
      <h1>The engineer behind the lab</h1>
    </div>
  </section>

  <section class="section-sm">
    <div class="container about-grid">
      <div class="about-card glass-card">
        <Logo />
        <h2>Hi, I'm Aspen.</h2>
        <p>
          I'm a process engineer in Richland, Washington. Chemical engineering by trade,
          nuclear by career, and these days a computational modeler more often than not.
          My career has run through reactor operations training, nuclear safety basis,
          commissioning, and plant engineering across the nuclear industry.
        </p>
        <p>
          Aspen Integra is where I connect that operational world to better tooling:
          speciated process models, optimization-driven mission planning, machine
          learning where it actually helps. The bet is that the nuclear backend generates
          some of the hardest data problems in any industry, and the machine-learning
          stack is finally good enough to be worth bringing to them.
        </p>
        <div class="about-links">
          <a href="/research/">Research →</a>
          <a href="/contact/">Contact →</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
        <p class="disclaimer">
          Aspen Integra is a personal project, built on my own time from public data and
          published literature. The views here are mine alone and do not represent my
          employer, past or present, or any organization I work with. Full work history
          lives on the CV page.
        </p>
      </div>

      <div class="about-stack">
        <h2>What I work with</h2>
        {
          skillGroups.map((group) => (
            <div class="glass-card skill-card">
              <h3>{group.domain}</h3>
              <ul>
                {group.skills.map((skill) => (
                  <li>{skill}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2 class="path-title">Projects I've developed</h2>
      <div class="card-grid cols-3">
        {
          projects.map((project) => (
            <a class="glass-card project-card" href={project.href}>
              <h3>{project.title}</h3>
              <p>{project.detail}</p>
              <span class="card-cta">Read more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2 class="path-title">Why everything here is open</h2>
      <div class="open-source-grid">
        <div class="glass-card open-card">
          <p>
            A large share of what the United States knows about its nuclear waste sits in
            public documents, produced by U.S. national laboratories, and scattered
            across thousands of pages of technical reports. A citizen who
            wants to understand how much waste is in the tanks, what is in it, or how
            long cleanup will take is effectively locked out, not by classification but
            by format.
          </p>
          <p>
            This lab treats that as the problem. Everything built here starts from
            published reports and public data services, and everything built here goes
            back out open source: the code, the data pipelines, the papers, and
            interactive tools that let anyone poke at the underlying numbers instead of
            taking a summary on faith. The playground on this site is the policy in
            practice — every experiment runs client-side in the visitor's browser, with
            its sources cited.
          </p>
          <p>
            Nuclear problems are genuinely complex, but complexity is not a reason to
            keep the public at arm's length. Public understanding of these issues should
            drive the conversation, and a conversation grounded in shared, explorable
            facts is the foundation for a positive nuclear future in the United States.
            If we want people to weigh the trade-offs of waste treatment honestly, the
            facts need to be somewhere they can actually reach them.
          </p>
        </div>

        <div class="about-stack">
          <h2>Open-source repositories</h2>
          {
            openSource.map((repo) => (
              <a class="glass-card repo-card" href={repo.href} target="_blank" rel="noopener noreferrer">
                <h3>{repo.title} ↗</h3>
                <p>{repo.detail}</p>
              </a>
            ))
          }
          <p class="open-note">
            All repositories MIT-licensed unless otherwise noted. Source documents remain
            the property of their issuing organizations and are cited throughout.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <h2 class="path-title">The path so far</h2>
      <ol class="timeline">
        {
          timeline.map((item) => (
            <li class="glass-card timeline-item">
              <span class="period">{item.period}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<style>
  .about-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 56rem) {
    .about-grid {
      grid-template-columns: 2fr 3fr;
      align-items: start;
    }
  }

  .about-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-card svg {
    width: 3rem;
    height: 3rem;
  }

  .about-card h2 {
    font-size: 1.4rem;
  }

  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .disclaimer {
    margin-top: 0.75rem;
    padding: 0.9rem 1.1rem;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--accent-soft);
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .about-stack {
    display: grid;
    gap: 1rem;
  }

  .about-stack h2 {
    font-size: 1.4rem;
  }

  .skill-card {
    padding: 1.4rem 1.6rem;
  }

  .skill-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.6rem;
  }

  .skill-card ul {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.3rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .path-title {
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }

  .open-source-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 56rem) {
    .open-source-grid {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  .open-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .open-card p {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .repo-card {
    padding: 1.1rem 1.3rem;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .repo-card:hover {
    text-decoration: none;
  }

  .repo-card h3 {
    font-size: 1rem;
    color: var(--accent-strong);
  }

  .repo-card p {
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .open-note {
    color: var(--text-muted);
    font-size: 0.8rem;
    padding-left: 0.3rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem 1.5rem;
    color: var(--text);
  }

  .project-card:hover {
    text-decoration: none;
  }

  .project-card h3 {
    font-size: 1.05rem;
  }

  .project-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    flex-grow: 1;
  }

  .card-cta {
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--accent-strong);
  }

  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
  }

  .timeline-item .period {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent-strong);
    white-space: nowrap;
    padding-top: 0.2rem;
    min-width: 7.5rem;
  }

  .timeline-item h3 {
    font-size: 1.02rem;
  }

  .timeline-item p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-top: 0.25rem;
  }
</style>
