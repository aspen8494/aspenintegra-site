---
import Layout from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../utils';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate - a.data.pubDate);
---

<Layout
  title="Blog"
  description="Writing from the Aspen Integra research lab: nuclear engineering, modeling, and machine learning in practice."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Blog</p>
      <h1>Notes from the lab</h1>
      <p class="lede">
        What I'm building and learning: modeling tools, nuclear engineering practice,
        applied machine learning.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="post-list">
        {
          posts.map((post) => (
            <a class="glass-card post-card" href={`/blog/${post.id}/`}>
              <div class="meta-row">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                {post.data.tags.length > 0 && <span>· {post.data.tags.join(', ')}</span>}
              </div>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="card-cta">Read post →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .post-list {
    display: grid;
    gap: 1.25rem;
    max-width: 44rem;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.5rem 1.6rem;
    color: var(--text);
  }

  .post-card:hover {
    text-decoration: none;
  }

  .post-card h2 {
    font-size: 1.25rem;
  }

  .post-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .card-cta {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--accent-strong);
  }
</style>
