---
import Layout from '../layouts/Base.astro';

const live = [
  {
    title: 'HLW Blend Sandbox',
    href: '/sandbox/',
    badge: 'Live',
    detail:
      'An in-browser toy of the campaign-building problem: pack waste blends into a volume band under WAC constraints and watch the glass mass respond. The same algorithms as the full campaign builder — greedy layer walk, dense simplex LP, SLSQP-style glass formulation — running client-side on a reduced dataset. No server, no build step, nothing leaves your browser.',
    features: [
      'Live scenario picker across 8 blend conditions',
      'Campaign recipe list with per-campaign glass metrics',
      'Mission roll-up: campaigns, waste, glass mass, canisters, duration',
      'Same-engine parity with the full application (within a few percent)',
    ],
    repo: 'https://github.com/aspen8494/hanford-blend-sandbox',
    related: [
      { href: '/research/ewg-campaign-builder/', label: 'The full campaign builder →' },
      { href: '/tank-comparison/', label: 'The tank data it plans on →' },
    ],
  },
  {
    title: 'Glass Property Explorer',
    href: '/glass-explorer/',
    badge: 'Live',
    detail:
      'Drag glass or waste-feed composition sliders and watch melt viscosity (VFT model), electrical conductivity, and PCT release respond in real time. Every property is computed two ways: by a 3-head neural network (GlassNet) running client-side, and by the published property formulations that serve as the acceptance basis. No server, no build step, nothing leaves your browser.',
    features: [
      'Two input modes: final glass composition or waste feed via the WL·feed mixing identity',
      'Live neural-network inference from shipped model weights (1.6 MB, zero dependencies)',
      'Published property models overlaid as the acceptance check, with pass/fail flags',
      'Inside-the-network views: signal flow, MC-dropout consensus, driver gradients, data-space map',
    ],
    repo: 'https://github.com/aspen8494/glass-property-explorer',
    related: [
      { href: '/research/glassnet-formulation-surrogate/', label: 'The GlassNet write-up →' },
      { href: '/glass-research-db/', label: 'The published glass literature →' },
    ],
  },
  {
    title: 'SRS vs Hanford Tank Comparison',
    href: '/tank-comparison/',
    badge: 'Live',
    detail:
      'A head-to-head look at the two largest defense tank-waste inventories in the country. The Savannah River Site F-/H-Area farms (51 tanks) against the 177-tank Hanford fleet: remaining volumes, curie inventories, phase splits, per-tank drill-downs, and the measured chemistry behind the sludge and salt batches. Every number carries its dataset, basis, and source, because the two sites do not publish their inventories on the same footing.',
    features: [
      'Head-to-head: 33.2 Mgal / 191 MCi at SRS vs 53.0 Mgal / 122.6 MCi at Hanford',
      'Six sections: overview, phases & farms, radionuclides, tank explorer, current chemistry, methods',
      '228-tank explorer with per-tank top-nuclide breakdowns',
      'Basis caveats surfaced, not buried: closure-residual vs current BBI explained',
    ],
    repo: 'https://github.com/aspen8494/srs-tank-waste-database',
    related: [
      { href: '/blog/srs-hanford-tank-comparison/', label: 'The findings write-up →' },
      { href: '/data/#tank-waste-db', label: 'Download the underlying database →' },
    ],
  },
  {
    title: 'Cross-Site Waste Taxonomy Explorer',
    href: '/waste-taxonomy/',
    badge: 'Live',
    detail:
      'Unsupervised machine learning across both tank farms: Hanford\'s 433 tank-phase compositions clustered into data-driven waste families (Ward on CLR-transformed chemistry), then every Savannah River measured batch and closure vector projected onto that taxonomy with shared-support distances. Find which Hanford waste each SRS batch resembles — and which batches have no analog at all.',
    features: [
      'Three feature spaces: sludge chemistry, salt chemistry, radionuclide signatures',
      'Analog finder: top-5 Hanford matches per SRS sample, with the supporting analytes',
      'Cluster profiles, UMAP geometry, and anomaly flags for data-quality review',
      'Full methods and caveats tab: coverage stated per claim, basis asymmetry explained',
    ],
    repo: 'https://github.com/aspen8494/srs-tank-waste-database',
    related: [
      { href: '/research/unsupervised-waste-taxonomy/', label: 'The taxonomy paper →' },
      { href: '/glass-research-db/', label: 'Glass research on this waste →' },
    ],
  },
  {
    title: 'Off-Gas Capture Visualizer',
    href: '/offgas-visualizer/',
    badge: 'Live',
    detail:
      'An interactive diagram of a melter off-gas treatment train (scrubber, WESP, demister, HEPA, carbon bed, silver mordenite, SCO/SCR) with decontamination-factor sliders on every capture stage and live stack-composition readouts. The default sliders reproduce the facility chain within a few percent on every tracked species. No server, nothing leaves your browser.',
    features: [
      '14-stage train visualized end to end: melter → scrubber → WESP → HEME → reheat → HEPA → fan → carbon bed → mordenite → HX → SCO → SCR → stack',
      'DF slider on every capture stage, recomputing the full train live',
      'Live stack readout with per-species flows and capture-to-sink ledgers',
      'Default-slider engine matches the model chain snapshot within tolerance (node-verified)',
    ],
    repo: 'https://github.com/aspen8494/offgas-visualizer',
    related: [
      { href: '/research/hlw-facility-mission-model/', label: 'The facility model behind the basis →' },
      { href: '/sandbox/', label: 'Feed composition drives the off-gas load →' },
    ],
  },
];
---

<Layout
  title="Interactive Nuclear Waste Tools — Playground"
  description="Free interactive dashboards and open-data tools for Hanford tank waste: SRS vs Hanford tank comparison, waste-taxonomy explorer, glass property explorer, and HLW blend sandbox — all client-side."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Playground</p>
      <h1>Interactive experiments</h1>
      <p class="lede">
        Small client-side models and visualizations. The ideas behind the research, but
        things you can poke at. Five are live below, all open source, all built from
        published public data. Every experiment runs in your browser, with its sources
        cited.
      </p>
    </div>
  </section>

  <section class="section-sm">
    <div class="container">
      <div class="live-grid">
        {
          live.map((item) => (
            <article class="glass-card live-card">
              <div class="live-head">
                <span class="live-badge">● {item.badge}</span>
                <a class="repo-link" href={item.repo} target="_blank" rel="noopener noreferrer">
                  Source ↗
                </a>
              </div>
              <h2>
                <a href={item.href}>{item.title}</a>
              </h2>
              <p>{item.detail}</p>
              <ul class="feature-list">
                {item.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              {item.related && (
                <p class="related-links">
                  {item.related.map((r) => (
                    <a href={r.href}>{r.label}</a>
                  ))}
                </p>
              )}
              <a class="btn btn-primary launch" href={item.href}>
                Open the sandbox →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .live-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 2.5rem;
  }

  .live-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.75rem 1.9rem;
  }

  .live-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .live-badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-strong);
    background: var(--accent-soft);
    border: 1px solid var(--accent-glow);
    padding: 0.22rem 0.75rem;
    border-radius: 999px;
    width: fit-content;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .repo-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }

  .repo-link:hover {
    color: var(--accent-strong);
    border-color: var(--accent-strong);
  }

  .live-card h2 {
    font-size: 1.45rem;
  }

  .live-card h2 a {
    color: inherit;
    text-decoration: none;
  }

  .live-card h2 a:hover {
    color: var(--accent-strong);
  }

  .live-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }

  .feature-list li {
    padding-left: 1.35rem;
    position: relative;
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .feature-list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--accent-strong);
    font-weight: 700;
  }

  .launch {
    align-self: flex-start;
    margin-top: 0.35rem;
  }

  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.85rem;
  }

  .related-links a {
    color: var(--accent-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
  }

  .related-links a:hover {
    border-color: var(--accent-strong);
  }
</style>
